---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Verified cooking, cleaning, and household management delivered in minutes. Launching soon in Enugu." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | AZAP</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
    </style>
</head>
<body class="bg-background text-ink antialiased font-sans selection:bg-accent/20 selection:text-ink relative">
    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer />
</body>
</html>
