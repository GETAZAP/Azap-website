---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero";

/*
 * The recruitment pitch. Supply is the binding constraint on the whole business,
 * so this page matters more than any customer-facing one right now.
 *
 * Two claims were removed because they are not true today: "get paid instantly"
 * (AZAP never holds the job money — the customer pays the pro directly) and the
 * PINCode system (that is in the app, which is not in the stores).
 *
 * The fee is stated in full, including the launch-month waiver AND the date it
 * ends. PRICING_MODEL.md L3: a fee increase only survives if it was pre-announced
 * and paired with named value. A free month that quietly becomes a paid one is
 * the surprise-hike pattern that produced the Etsy strike and four years of
 * Urban Company protests — in miniature, with five artisans who all know
 * each other.
 */
---

<Layout
  title="For professionals"
  description="Get jobs in Enugu. Keep 100% of what you charge. AZAP takes no commission. ₦1,000 per finished job, and nothing at all during launch month."
>
  <PageHero
    client:load
    title="Keep everything you charge."
    subtitle="AZAP brings you work in Enugu. We take no commission. You set your own prices and keep every naira of them."
    image="/images/provider_hero.jpg"
  />

  <section class="py-24 px-6">
    <div class="container-tight !px-0">

      <div class="max-w-4xl mx-auto rounded-3xl bg-ink text-white p-10 md:p-14 mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-accent mb-6 block">What it costs you</span>
        <div class="flex flex-col sm:flex-row sm:items-end gap-4 mb-8">
          <div class="text-6xl md:text-7xl font-extrabold tracking-tight">₦1,000</div>
          <div class="text-zinc-400 font-medium pb-2 text-lg">per job you accept and finish</div>
        </div>
        <ul class="space-y-4 text-zinc-300 font-medium">
          <li class="flex gap-3"><span class="h-1.5 w-1.5 bg-accent rounded-full mt-2.5 shrink-0"></span> <span><strong class="text-white">No commission, ever.</strong> A ₦40,000 job costs you the same ₦1,000 as a ₦6,000 one.</span></li>
          <li class="flex gap-3"><span class="h-1.5 w-1.5 bg-accent rounded-full mt-2.5 shrink-0"></span> <span>Nothing to pay when we send you no work. No monthly fee, no signup fee.</span></li>
          <li class="flex gap-3"><span class="h-1.5 w-1.5 bg-accent rounded-full mt-2.5 shrink-0"></span> <span>You hear the job and the price before you accept. Say no and it costs you nothing.</span></li>
          <li class="flex gap-3"><span class="h-1.5 w-1.5 bg-accent rounded-full mt-2.5 shrink-0"></span> <span>The customer pays you directly, in cash or by transfer. We never hold your money.</span></li>
        </ul>

        <div class="mt-10 pt-8 border-t border-white/10">
          <p class="text-zinc-300 font-medium leading-relaxed">
            <strong class="text-white">Every job is free during our launch month.</strong>
            You'll still see the ₦1,000 recorded against each job so you know what it
            would have cost, but you pay nothing at all. We'll tell you the exact date
            it ends before it does, in writing. No surprises.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="card-enterprise p-10">
          <h2 class="text-xl font-extrabold mb-3 tracking-tight">You set the price</h2>
          <p class="text-zinc-500 font-medium text-sm leading-relaxed">
            You look at the job and quote the customer yourself. AZAP has no opinion on
            what the work is worth and never negotiates on your behalf.
          </p>
        </div>
        <div class="card-enterprise p-10">
          <h2 class="text-xl font-extrabold mb-3 tracking-tight">Total flexibility</h2>
          <p class="text-zinc-500 font-medium text-sm leading-relaxed">
            We call you with a job. Take it or turn it down. There's no penalty for
            saying no, and no minimum you have to accept.
          </p>
        </div>
        <div class="card-enterprise p-10">
          <h2 class="text-xl font-extrabold mb-3 tracking-tight">Real customers</h2>
          <p class="text-zinc-500 font-medium text-sm leading-relaxed">
            We speak to every customer on the phone before we call you, so you're not
            crossing Enugu for a job that was never serious.
          </p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto mt-8 rounded-3xl border border-zinc-200 bg-white p-10 md:p-12">
        <h2 class="text-2xl md:text-3xl mb-5">What we'll need from you</h2>
        <p class="text-zinc-600 font-medium leading-relaxed mb-6">
          Customers let us into their homes because we check who we send. Four things,
          and we go through all of them with you:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex gap-3 items-start"><span class="h-1.5 w-1.5 bg-ink rounded-full mt-2.5 shrink-0"></span><div><strong class="block text-ink">Your NIN</strong><span class="text-sm text-zinc-500 font-medium">National Identity Number, with the document</span></div></div>
          <div class="flex gap-3 items-start"><span class="h-1.5 w-1.5 bg-ink rounded-full mt-2.5 shrink-0"></span><div><strong class="block text-ink">Your bank account</strong><span class="text-sm text-zinc-500 font-medium">In your own name</span></div></div>
          <div class="flex gap-3 items-start"><span class="h-1.5 w-1.5 bg-ink rounded-full mt-2.5 shrink-0"></span><div><strong class="block text-ink">A guarantor</strong><span class="text-sm text-zinc-500 font-medium">Someone who can vouch for you, with their phone number</span></div></div>
          <div class="flex gap-3 items-start"><span class="h-1.5 w-1.5 bg-ink rounded-full mt-2.5 shrink-0"></span><div><strong class="block text-ink">A photo of you</strong><span class="text-sm text-zinc-500 font-medium">So customers know who's arriving</span></div></div>
        </div>
      </div>

    </div>
  </section>

  <section class="py-32 px-6 section-dark text-center">
    <div class="container-tight max-w-3xl">
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">How we find pros.</h2>
      <p class="text-lg text-zinc-400 font-medium max-w-xl mx-auto leading-relaxed">
        We approach artisans ourselves and meet them before they take any work. There is no
        online application, and nobody joins AZAP without us having sat down with them first.
      </p>
      <p class="text-lg text-zinc-400 font-medium max-w-xl mx-auto leading-relaxed mt-5">
        If you are already talking to us, everything on this page is what we agreed, in writing.
      </p>
    </div>
  </section>
</Layout>
