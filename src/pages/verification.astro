---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero';
---

<Layout title="Verification" description="The four checks every AZAP pro passes before they can take a job: identity, bank account, guarantor and photograph.">
    <PageHero 
        client:load
        title="Who we send you."
        subtitle="Four checks, every one completed and approved, before anybody can take a job."
        image="/images/nfc_localized.jpg"
    />
    
    <section class="py-32 px-6">
        <div class="container-tight !px-0 max-w-3xl space-y-16">
            {[
              /* Four stages, not five, and described as they actually run.
                 This page previously claimed NIN verification "against NIMC
                 databases", BVN and bank-name cross-matching, two guarantors and
                 a face liveness check. None of that automated infrastructure
                 exists: NIN checks require a NIMC-licensed agent we have not
                 appointed, and every stage here is reviewed by a human. */
              { n: '01', t: 'Identity', d: 'We collect the National Identity Number and the identity document itself, and check the name and photograph against everything else we hold.' },
              { n: '02', t: 'Bank account', d: 'An account in the pro\'s own name, so there is a traceable place their money goes and a real institution that has already identified them.' },
              { n: '03', t: 'Guarantor', d: 'A named, contactable person who vouches for the pro and stakes their own name on it. Culturally this is the strongest of the four.' },
              { n: '04', t: 'Photograph', d: 'So the person who knocks on your door is the person on the identity document.' },
            ].map(step => (
                <div class="flex flex-col md:flex-row gap-8 items-start">
                    <div class="text-6xl font-extrabold text-zinc-200 shrink-0 leading-none">{step.n}</div>
                    <div>
                        <h2 class="text-2xl font-extrabold mb-2 tracking-tight">{step.t}</h2>
                        <p class="text-zinc-500 text-base leading-relaxed font-medium">{step.d}</p>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <section class="py-32 px-6 section-dark text-center">
        <div class="container-tight max-w-3xl">
            <h2 class="text-4xl font-extrabold tracking-tight mb-6">No checks, no jobs.</h2>
            <p class="text-lg text-zinc-400 font-medium leading-relaxed mb-10">A pro can only take work once all four checks have passed and an admin has approved each one. Until then they cannot see a single job.</p>
        </div>
    </section>
</Layout>
