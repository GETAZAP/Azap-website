    ],
  },
  {
    id: 'your-responsibilities',
    title: 'What we ask of you',
    body: [
      'Give us accurate details, including a phone number you will answer. Be there at the time you agreed. Treat the pro we send with courtesy.',
      'Do not use our booking form or contact form to send abuse, false bookings, spam, or anything unlawful, and do not submit somebody else\'s details without their knowledge.',
      'Do not ask a pro to carry out work that is unlawful, unsafe, or that requires a licence they do not hold.',
    ],
  },
  {
    id: 'website-use',
    title: 'Using this website',
    body: [
      'You may use this website for its intended purpose. You may not attempt to gain unauthorised access to it or to any system behind it, interfere with its operation, scrape or harvest data from it, or use automated means to submit bookings.',
      'The content, design, text, graphics and logo on this website belong to AZAP and may not be copied or reused without our permission.',
      'This website may link to third-party sites. We are not responsible for their content or their practices.',
    ],
  },
  {
    id: 'suspension',
    title: 'Refusing or withdrawing service',
    body: [
      'We may decline a booking, refuse to serve you, or stop serving you where you have breached these terms, where we believe a request is not genuine, where a pro has been treated abusively, or where continuing would put somebody at risk.',
      'We will tell you if we do this, and why, unless there is a good reason not to.',
    ],
  },
  {
    id: 'no-employment',
