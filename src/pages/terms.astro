---

<Layout title="Terms of Service" description="The terms governing your use of AZAP in Enugu, Nigeria.">
  <section class="px-6 pt-28 md:pt-40 pb-20 md:pb-32">
    <div class="container-tight !px-0 max-w-3xl">
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight md:text-5xl">Terms of Service.</h1>
      <p class="mb-10 text-sm font-bold uppercase tracking-widest text-zinc-600">
        Last updated: {LAST_UPDATED}
      </p>

      <div class="mb-14 rounded-3xl border border-zinc-200/80 bg-white p-8">
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-zinc-600">Contents</p>
        <!-- CSS columns rather than a grid: a grid flows left-to-right, so a
             numbered contents list would read 1, 2 across the page instead of
             running 1..n down the first column. -->
        <ol class="gap-x-8 sm:columns-2">
          {sections.map((s, i) => (
            <li class="mb-2 flex break-inside-avoid gap-3 text-sm font-medium leading-snug">
              <span class="tabular-nums text-zinc-300">{i + 1}.</span>
              <a href={`#${s.id}`} class="text-zinc-600 underline-offset-4 hover:text-ink hover:underline">{s.title}</a>
            </li>
          ))}
        </ol>
      </div>

      <div class="space-y-10 font-medium leading-relaxed text-zinc-500">
        {sections.map((s, i) => (
          <div id={s.id} class="scroll-mt-28">
            <h2 class="mb-3 text-xl font-extrabold text-ink">{i + 1}. {s.title}</h2>
            {s.body.map((p) => <p class="mb-3 last:mb-0" set:html={p} />)}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
