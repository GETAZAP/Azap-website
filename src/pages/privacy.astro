---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy">
    <section class="pt-40 pb-32 px-6">
        <div class="container-tight max-w-3xl !px-0">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-12">Privacy Policy.</h1>
            <div class="space-y-10 text-zinc-500 font-medium leading-relaxed">
                <div>
                    <h2 class="text-xl font-extrabold text-ink mb-3">1. Data Collection</h2>
                    <p>We collect information you provide directly to us when you create an account, request a service, or communicate with us. This includes your name, email, phone number, and address.</p>
                </div>
                <div>
                    <h2 class="text-xl font-extrabold text-ink mb-3">2. Verification Tech</h2>
                    <p>Our NFC verification system logs the precise timestamp and location of service starts and completions to ensure security and quality of service.</p>
                </div>
                <div>
                    <h2 class="text-xl font-extrabold text-ink mb-3">3. Third Parties</h2>
                    <p>We do not sell your personal data. We share information with service providers only as necessary to fulfill your requests.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>
