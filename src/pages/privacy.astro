---
import Layout from '../layouts/Layout.astro';

/*
 * Written against DATA_TELEMETRY_MANIFEST.md and the live schema, not against
 * what a privacy policy usually says.
 *
 * The significant addition over the previous version: it now covers everyone
 * whose data AZAP holds, not only customers. Professionals submit a National
 * Identity Number and its scan, bank account details and a photograph, and they
 * name a guarantor — a third party who never used the service and never agreed
 * to anything. That is the most sensitive data in the system and the policy was
 * silent on all of it.
 *
 * Two things are stated as gaps rather than dressed up, because the manifest
 * records them as gaps:
 *   - no retention schedule is implemented anywhere (no TTL, no purge job)
 *   - guarantor records have no deletion path
 *
 * The Supabase region is not asserted. The manifest refuses to assert it because
 * nothing in the repo records it; confirm it in the dashboard and §11 can be
 * specific about where data actually sits.
 *
 * TO BE FILLED IN BEFORE THIS IS RELIED ON: the CAC registration number, a
 * registered office address, and the named Data Protection Officer. The
 * controller is AZAP Operations Limited, confirmed by the founders 2026-09-09.
 * LAUNCH_CHECKLIST.md carries NDPC registration and a DPO as open P0 items.
 *
 * Not drafted by a lawyer.
 */

const LAST_UPDATED = '9 September 2026';

const sections = [
  {
    id: 'who',
    title: 'Who we are',
    body: [
      'AZAP is a service operated by <strong class="text-ink">AZAP Operations Limited</strong>, a company registered in Nigeria. We introduce people who need work doing to independent tradespeople and household professionals, and coordinate that work by telephone.',
      'For the purposes of the Nigeria Data Protection Act 2023, <strong class="text-ink">AZAP Operations Limited is the data controller</strong> for the information described in this policy. That means we decide what is collected and why, and we are answerable for it.',
    ],
  },
  {
    id: 'scope',
    title: 'What this policy covers',
    body: [
      'This policy covers the AZAP website, the bookings taken through it, and the telephone service run around those bookings. It also covers the information we collect from professionals who work through AZAP.',
      'We have written it against what our systems actually store. Where we do not do something a policy of this kind usually claims, we say so rather than leaving the impression that we do.',
    ],
  },
  {
    id: 'whose',
    title: 'Whose information we hold',
    body: [
      'Four groups of people: <strong class="text-ink">customers</strong> who make a booking; <strong class="text-ink">professionals</strong> who take work through us; <strong class="text-ink">guarantors</strong> named by a professional; and <strong class="text-ink">visitors</strong> to this website.',
      'The third group matters and is easy to overlook. A guarantor is a person named by somebody else. They did not fill in a form and may not know a company holds their details. Section 6 sets out what we hold about them and what they can ask us to do.',
    ],
  },
  {
    id: 'customers',
    title: 'What we collect from customers',
    body: [
      'When you make a booking: your name; the telephone number you want us to call; the address of the job; whatever you tell us about the work; and an email address only if you choose to give one, which is optional.',
      'We also record timestamps for when a booking was made, confirmed, dispatched and completed, which pro was sent, and what was agreed on the call.',
      'We store a one-way cryptographic hash of the IP address a booking was submitted from. This lets us stop the form being flooded. It is not the address itself and cannot be reversed into one.',
      'If you write to us through the contact form, we receive what you put into it.',
      '<strong class="text-ink">We do not collect from customers:</strong> any account or password, because there are no accounts; any card or bank details, because no money passes through AZAP; or your device location.',
    ],
  },
  {
    id: 'pros',
    title: 'What we collect from professionals',
    body: [
      'Before a professional can take work through AZAP we collect and hold: their <strong class="text-ink">National Identity Number and a scan of the identity document</strong>; <strong class="text-ink">bank account details</strong> in their own name; the <strong class="text-ink">name and telephone number of a guarantor</strong>; and a <strong class="text-ink">photograph</strong> of them. We also hold their name, telephone number, the trades they work in and the area they cover.',
      'This is the most sensitive information in our systems and we treat it accordingly. Identity documents and photographs are held in restricted storage, separate from ordinary booking records.',
      'We use it to establish that a professional is who they say they are, that they can be traced and vouched for, and to tell a customer honestly what has been checked. We do not publish a professional\'s NIN, bank details, guarantor or document scans to customers or to anyone else.',
      'A professional may also submit a NIN as a customer, where they use the service in that capacity.',
    ],
  },
  {
    id: 'guarantors',
    title: 'What we collect about guarantors',
    body: [
      'When a professional names a guarantor, we hold that guarantor\'s <strong class="text-ink">name and telephone number</strong>, and we may telephone them to confirm they vouch for the professional.',
      'We ask professionals to tell their guarantor before naming them. We cannot guarantee that they do.',
      '<strong class="text-ink">If you have been named as a guarantor and would rather not be, contact us and we will remove your details.</strong> You do not need an account, a reference number, or a reason. We should say plainly that this removal is currently done by hand on request rather than by an automated process.',
    ],
  },
  {
    id: 'visitors',
    title: 'What we collect from website visitors',
    body: [
      'Almost nothing. This website sets no cookies and carries no analytics, tag manager, advertising pixel or third-party tracker of any kind.',
      'As with any website, our host receives the technical information your browser sends in order to serve a page, including your IP address. Everything else the page needs — typefaces, images, scripts — is served from this domain, so opening a page sends nothing to anybody else.',
    ],
  },
  {
    id: 'why',
    title: 'Why we hold it, and on what basis',
    body: [
      '<strong class="text-ink">To provide the service you asked for.</strong> Calling you back, telling a pro where to go, checking the work was done. Basis: performance of a contract, and your request.',
      '<strong class="text-ink">To verify professionals.</strong> Establishing identity, traceability and a personal reference before anyone is sent into a home. Basis: our legitimate interest, and the interest of every customer, in knowing who is being sent.',
      '<strong class="text-ink">To keep a record of each job.</strong> Who was sent, when, and what was agreed, so a dispute can be settled on evidence. Basis: legitimate interest.',
      '<strong class="text-ink">To prevent abuse.</strong> The hashed IP address exists only to stop the booking form being flooded. Basis: legitimate interest.',
      '<strong class="text-ink">To comply with the law</strong> where we are required to.',
      'We do not use your information to build a profile of you, to make automated decisions about you, or for advertising.',
    ],
  },
  {
    id: 'sharing',
    title: 'Who else receives it',
    body: [
      '<strong class="text-ink">We do not sell personal information to anyone, ever.</strong>',
      '<strong class="text-ink">The pro we send you</strong> receives your name, address, telephone number and a description of the job. They cannot do the work without it.',
      '<strong class="text-ink">You</strong> receive the pro\'s name and telephone number so you know who is coming.',
      '<strong class="text-ink">Supabase</strong> hosts the database and server functions the booking is stored and processed on.',
      '<strong class="text-ink">Resend</strong> delivers the internal email telling whoever is dispatching that a booking has come in.',
      '<strong class="text-ink">Web3Forms</strong> delivers contact form messages, and only sees them if you use that form.',
      '<strong class="text-ink">Vercel</strong> hosts this website and handles the request when you load a page.',
      'That is the complete list. Nothing else on this site contacts a third party — the typefaces are served from our own domain rather than from Google Fonts, so no request leaves here simply because you opened a page.',
      'We may also disclose information where the law requires it, to establish or defend a legal claim, or as part of a sale or reorganisation of the business.',
    ],
  },
  {
    id: 'where',
    title: 'Where it is processed',
    body: [
      'The services listed above are operated by companies outside Nigeria, so your information may be stored and processed abroad.',
      'Where the Nigeria Data Protection Act requires a lawful basis for a cross-border transfer, we rely on the transfer being necessary to provide the service you asked us for. We are working to record and publish the specific location our database is hosted in, and this section will say so once confirmed.',
    ],
  },
  {
    id: 'retention',
    title: 'How long we keep it',
    body: [
      'We keep booking records for as long as they are useful for running the service and settling any dispute about a job, and professional verification records for as long as that professional works through AZAP.',
      '<strong class="text-ink">We do not currently operate an automatic deletion schedule.</strong> We would rather tell you that than publish a retention period we do not enforce. Establishing one is work we know we owe you.',
      'You can ask us to delete your information at any time, and we will, subject to anything we are legally required to keep.',
    ],
  },
  {
    id: 'security',
    title: 'How we protect it',
    body: [
      'Access to customer and professional records is restricted to the people who run the service, and enforced by the database itself rather than by convention: our systems refuse requests for records the requester is not entitled to, rather than relying on an application to ask politely.',
      'Identity documents and photographs sit in restricted storage. Card and bank payment details never reach us at all, because no money passes through AZAP.',
      'No system is perfectly secure, and we will not claim ours is. What we can say is that we have deliberately reduced what there is to lose: no passwords, no card data, no location history.',
    ],
  },
  {
    id: 'breach',
    title: 'If something goes wrong',
    body: [
      'If a breach occurs that is likely to put your rights at risk, we will notify the Nigeria Data Protection Commission as required and tell affected people directly, describing what happened, what it means for you, and what we are doing about it.',
      'If you believe your information has been exposed, tell us at <a href="mailto:admin@getazap.com" class="font-bold text-accent-ink hover:underline">admin@getazap.com</a> and we will investigate.',
    ],
  },
  {
    id: 'rights',
    title: 'Your rights',
    body: [
      '<strong class="text-ink">Under the Nigeria Data Protection Act 2023</strong>, which is the law that applies to us, you can: ask what we hold about you and get a copy; have inaccurate information corrected; ask us to delete it; object to how we are using it; ask us to restrict how we use it; withdraw consent where we relied on it; and complain to the Nigeria Data Protection Commission.',
      'These rights apply whether you are a customer, a professional, or a guarantor who never asked to be named.',
      'If you are reading this from the European Union or United Kingdom, California, or Brazil, the equivalent rights under the GDPR, the CCPA and the LGPD are available to you on request. We do not sell personal information under any of them.',
    ],
  },
  {
    id: 'exercising',
    title: 'How to exercise your rights',
    body: [
      'Write to <a href="mailto:admin@getazap.com" class="font-bold text-accent-ink hover:underline">admin@getazap.com</a> from any address, or tell us on the telephone. You do not need an account or a reference number.',
      'We will take reasonable steps to confirm it is really you before we act, which usually means asking about a booking only you would know about. We will respond within 30 days and tell you if we need longer.',
      'We do not charge for this.',
    ],
  },
  {
    id: 'complaints',
    title: 'Complaining to the regulator',
    body: [
      'If you are not satisfied with how we have handled your information or your request, you can complain to the <strong class="text-ink">Nigeria Data Protection Commission</strong>. You do not have to come to us first, though we would prefer the chance to put it right.',
    ],
  },
  {
    id: 'cookies',
    title: 'Cookies and tracking',
    body: [
      '<strong class="text-ink">This website sets no cookies.</strong> There is no analytics, no tag manager, no advertising pixel and no third-party tracker on it.',
      'It stores nothing in your browser either — no local storage, no session storage, no fingerprinting. Close the tab and there is no trace of you on the device.',
      'This is why you have not been shown a cookie banner. There is no consent to collect, because there is nothing to consent to. A banner here would be theatre.',
      'That is a deliberate choice rather than an oversight, and if it ever changes this section changes first and before the tracking starts.',
    ],
  },
  {
    id: 'marketing',
    title: 'Marketing',
    body: [
      'We do not send marketing messages to customers. The calls and messages you receive are about your booking.',
      'If you leave your email address on our homepage asking to be told when we reach your city, we use it for that and nothing else, and you can ask us to remove it at any time.',
    ],
  },
  {
    id: 'calls',
    title: 'Telephone calls',
    body: [
      'This service runs on telephone calls: we call to confirm a booking and again afterwards to check the work was done.',
      'We do not record these calls. We do write down what was agreed, and that written record forms part of the booking.',
    ],
  },
  {
    id: 'children',
    title: 'Children',
    body: [
      'AZAP is not intended for anyone under 18 and we do not knowingly collect information about children. If you believe we have, tell us and we will delete it.',
    ],
  },
  {
    id: 'changes',
    title: 'Changes to this policy',
    body: [
      'We may update this policy. The date at the top is the date of the last real change, not the date the page was last published.',
      'Where a change materially affects how we use information we already hold, we will say so here before it takes effect.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact',
    body: [
      'Privacy questions, access requests, corrections and deletions: <a href="mailto:admin@getazap.com" class="font-bold text-accent-ink hover:underline">admin@getazap.com</a>',
      'Anything else: <a href="mailto:support@getazap.com" class="font-bold text-accent-ink hover:underline">support@getazap.com</a>',
      'You can also reach us through our <a href="/contact" class="font-bold text-accent-ink hover:underline">contact page</a>.',
    ],
  },
];
---

<Layout
  title="Privacy Policy"
  description="What AZAP collects from customers, professionals and guarantors, why, who it reaches, and how to have it deleted."
>
  <section class="px-6 pt-40 pb-32">
    <div class="container-tight !px-0 max-w-3xl">
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight md:text-5xl">Privacy Policy.</h1>
      <p class="mb-10 text-sm font-bold uppercase tracking-widest text-zinc-600">
        Last updated: {LAST_UPDATED}
      </p>

      <div class="mb-14 rounded-3xl border border-zinc-200/80 bg-white p-8">
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-zinc-600">Contents</p>
        <!-- CSS columns rather than a grid: a grid flows left-to-right, so a
             numbered contents list would read 1, 2 across the page instead of
             running 1..n down the first column. -->
        <ol class="gap-x-8 sm:columns-2">
          {sections.map((s, i) => (
            <li class="mb-2 flex break-inside-avoid gap-3 text-sm font-medium leading-snug">
              <span class="tabular-nums text-zinc-300">{i + 1}.</span>
              <a href={`#${s.id}`} class="text-zinc-600 underline-offset-4 hover:text-ink hover:underline">{s.title}</a>
            </li>
          ))}
        </ol>
      </div>

      <div class="space-y-10 font-medium leading-relaxed text-zinc-500">
        {sections.map((s, i) => (
          <div id={s.id} class="scroll-mt-28">
            <h2 class="mb-3 text-xl font-extrabold text-ink">{i + 1}. {s.title}</h2>
            {s.body.map((p) => <p class="mb-3 last:mb-0" set:html={p} />)}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
