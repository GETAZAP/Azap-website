---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero';
---

<Layout title="Pricing">
    <PageHero 
        client:load
        title="Transparent pricing." 
        subtitle="Free for everyone, with premium upgrades that unlock after you experience the service."
    />
    
    <section class="py-32 px-6">
        <div class="container-tight !px-0">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="card-enterprise p-12 flex flex-col justify-between">
                    <div>
                        <h3 class="text-2xl font-extrabold mb-1 tracking-tight">Free</h3>
                        <p class="text-zinc-400 font-bold text-xs uppercase tracking-widest mb-10">Default</p>
                        <div class="text-5xl font-extrabold mb-10 tracking-tighter">₦0</div>
                        <ul class="space-y-3 text-zinc-500 font-medium text-sm mb-10">
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ink rounded-full" /> Standard rates</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ink rounded-full" /> Basic matching</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ink rounded-full" /> WhatsApp support</li>
                        </ul>
                    </div>
                    <a href="/#waitlist" class="btn-capsule bg-ink text-white border-transparent hover:bg-zinc-800 w-full py-4">Get Started</a>
                </div>

                <div class="bg-ink text-white p-12 rounded-3xl flex flex-col justify-between relative shadow-2xl md:scale-105 z-10">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-accent text-white px-5 py-1 rounded-full text-[10px] font-extrabold tracking-widest uppercase">Unlocks after 3 bookings</div>
                    <div>
                        <h3 class="text-2xl font-extrabold mb-1 tracking-tight">AZAP Pass</h3>
                        <p class="text-zinc-400 font-bold text-xs uppercase tracking-widest mb-10">₦3,500 / month</p>
                        <div class="text-5xl font-extrabold mb-10 tracking-tighter text-white">20% <span class="text-xl text-zinc-400 font-medium">Off</span></div>
                        <ul class="space-y-3 text-zinc-400 font-medium text-sm mb-10">
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-white rounded-full" /> Priority matching</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-white rounded-full" /> 5 saved providers</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-white rounded-full" /> Recurring scheduler</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-white rounded-full" /> 1 free cancel/mo</li>
                        </ul>
                    </div>
                    <a href="/#waitlist" class="btn-capsule bg-white text-ink border-transparent hover:bg-zinc-100 w-full py-4">Request Access</a>
                </div>

                <div class="card-enterprise p-12 flex flex-col justify-between">
                    <div>
                        <h3 class="text-2xl font-extrabold mb-1 tracking-tight">AZAP Plus</h3>
                        <p class="text-zinc-400 font-bold text-xs uppercase tracking-widest mb-10">₦6,500 / month</p>
                        <div class="text-5xl font-extrabold mb-10 tracking-tighter">30% <span class="text-xl text-zinc-400 font-medium">Off</span></div>
                        <ul class="space-y-3 text-zinc-500 font-medium text-sm mb-10">
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ink rounded-full" /> Unlimited saved providers</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ink rounded-full" /> Household profile</li>
                            <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 bg-ink rounded-full" /> B2B invoicing</li>
                        </ul>
                    </div>
                    <a href="/#waitlist" class="btn-capsule bg-ink text-white border-transparent hover:bg-zinc-800 w-full py-4">Request Access</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
