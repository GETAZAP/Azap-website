---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero';
---

<Layout title="Contact Us">
    <PageHero 
        client:load
        title="We're here to help." 
        subtitle="Have questions about our services or want to apply as a provider? Reach out to the AZAP team."
    />
    
    <section class="py-24 px-6">
        <div class="container-tight !px-0 grid grid-cols-1 md:grid-cols-2 gap-20">
            <div>
                <h2 class="text-3xl font-extrabold tracking-tight mb-8">Get in Touch</h2>
                <div class="space-y-8">
                    <div>
                        <h4 class="text-zinc-400 font-bold text-xs uppercase tracking-widest mb-1">Email</h4>
                        <p class="text-xl font-extrabold text-ink">admin@getazap.com</p>
                    </div>
                    <div>
                        <h4 class="text-zinc-400 font-bold text-xs uppercase tracking-widest mb-1">Location</h4>
                        <p class="text-xl font-extrabold text-ink">Enugu, Nigeria</p>
                    </div>
                    <div>
                        <h4 class="text-zinc-400 font-bold text-xs uppercase tracking-widest mb-1">Support</h4>
                        <p class="text-xl font-extrabold text-ink">+234 800 000 0000</p>
                    </div>
                </div>
            </div>
 
            <form class="space-y-5" onsubmit="event.preventDefault()">
                <div class="space-y-1.5">
                    <label class="text-xs font-bold uppercase tracking-widest text-zinc-400">Name</label>
                    <input type="text" required class="w-full px-5 py-4 rounded-xl bg-white border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all font-medium text-ink" />
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-bold uppercase tracking-widest text-zinc-400">Email</label>
                    <input type="email" required class="w-full px-5 py-4 rounded-xl bg-white border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all font-medium text-ink" />
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-bold uppercase tracking-widest text-zinc-400">Message</label>
                    <textarea rows="5" required class="w-full px-5 py-4 rounded-xl bg-white border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all font-medium text-ink"></textarea>
                </div>
                <button type="submit" class="btn-capsule bg-ink text-white border-transparent hover:bg-zinc-800 w-full py-4 text-base shadow-md">Send Message</button>
            </form>
        </div>
    </section>
</Layout>
