---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero';
import ContactForm from '../components/ContactForm';

/*
 * A single centred column, matching /book.
 *
 * An earlier version had a dark "Just need a pro?" banner, a two-column layout
 * with the contact details set in extrabold, and a "Thinking of joining?" panel.
 * All three were removed: the banner forced a route nobody asked for, the bold
 * treatment shouted at an email address, and the joining panel hung below the
 * form with nothing to align to.
 *
 * The contact details now sit under the form in plain weight, where someone who
 * would rather email can find them without being sold anything first.
 */

const PHONE_E164 = '+2347047231349';
const PHONE_DISPLAY = '+234 704 723 1349';
---

<Layout
  title="Contact Us"
  description="Get in touch with the AZAP team in Enugu. Leave us a number and a real person gets back to you."
>
  <PageHero
    client:load
    title="Talk to us."
    subtitle="A question, a booking that needs sorting, or something else entirely. Leave a number and a real person gets back to you."
  />

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-xl">
      <ContactForm client:load />

      {/* Both details are links, not printed text. Most of this traffic is on a
          phone, and AZAP's whole operation runs on someone picking up — a
          number you have to copy out by hand is a number that does not get
          called. */}
      <div class="mt-12 border-t border-zinc-200 pt-8 text-center">
        <p class="text-sm font-medium leading-relaxed text-zinc-600">
          Would rather call? <a href={`tel:${PHONE_E164}`} class="font-bold text-ink underline underline-offset-4">{PHONE_DISPLAY}</a>
        </p>
        <p class="mt-2 text-sm font-medium leading-relaxed text-zinc-600">
          Would rather email? <a href="mailto:support@getazap.com" class="font-bold text-ink underline underline-offset-4">support@getazap.com</a>
        </p>
        <p class="mt-3 text-sm font-medium text-zinc-600">
          We operate in Enugu, Nigeria.
        </p>
      </div>
    </div>
  </section>
</Layout>
