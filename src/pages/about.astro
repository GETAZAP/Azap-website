---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero";

/*
 * Rewritten from abstract values to concrete, checkable facts.
 *
 * This page had no <h1> at all — it opened on <h2>Our Mission — and its three
 * cards were headed Integrity / Innovation / Excellence, which say nothing and
 * could belong to any company in any industry. The copy claimed providers were
 * "continuously audited" (they are vetted once, in person), described them as
 * "elite", and promised "five-star hospitality standards", none of which AZAP
 * can substantiate or would even want to: it dispatches plumbers, not a
 * concierge.
 *
 * The three things below are chosen because each is true, checkable, and
 * something a competitor would struggle to copy.
 *
 * A two-column "the problem is on both sides" section sat above them and was
 * removed. It opened the page on two blocks of anxiety -- customers cannot tell
 * a good artisan from a bad one, strangers in your home -- which reads as a
 * slight on the trade AZAP recruits from. Artisans are pointed at this site;
 * the page should not tell them their profession is a gamble.
 */

const principles = [
  {
    t: "We take no commission",
    d: "Your pro keeps every naira they charge you. We are paid a flat fee for finding them the work, and it never comes out of their price. Most platforms take 10 to 30 percent, and that ends up in your quote.",
  },
  {
    t: "We check who we send",
    d: "Government ID, a bank account in their own name, a named guarantor, and a photograph. Four things, all of them before a pro can take a single job. We can tell you exactly what we checked because we checked it.",
  },
  {
    t: "One neighbourhood at a time",
    d: "We would rather be genuinely reliable in a five-kilometre radius than thinly spread across three cities. A vetted pro twenty minutes away is worth more than a thousand of them somewhere else.",
  },
];

/* Henry's portrait is the only one shot on a dark background, so he sits in the
   middle: light, dark, light reads as a deliberate arrangement rather than one
   photo that does not match the other two. */
const team = [
  { name: "Michael Echezona", role: "Chief Executive Officer", img: "/images/team/michael-echezona.jpg" },
  { name: "Henry Leleh", role: "Chief Marketing Officer", img: "/images/team/henry-leleh.jpg" },
  { name: "Maduabuchi Okeke", role: "Chief Technical Officer", img: "/images/team/maduabuchi-okeke.jpg" },
];
---

<Layout
  title="About Us"
  description="AZAP connects people in Enugu with vetted service providers, whatever the job. No commission, no booking fee, and we never set the price of your job."
>
  <PageHero
    client:load
    title="Why AZAP exists."
    subtitle="Good artisans and the people who need them have no reliable way to find each other. AZAP is the road between them."
  />

  <section class="px-6 py-24">
    <div class="container-tight !px-0">

      <h2 class="mb-8 text-3xl font-extrabold tracking-tight md:text-4xl">What we hold to</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {principles.map((p) => (
          <div class="card-enterprise p-8 md:p-10">
            <h3 class="mb-3 text-xl font-extrabold tracking-tight">{p.t}</h3>
            <p class="text-sm font-medium leading-relaxed text-zinc-500">{p.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-20">
        <h2 class="mb-5 text-3xl font-extrabold tracking-tight md:text-4xl">Meet the team</h2>
        <p class="mb-8 max-w-2xl text-lg font-medium leading-relaxed text-zinc-500">
          We meet every artisan on the platform ourselves before they take a single job.
          If one of us has approached you, this is who you were talking to.
        </p>
        <!-- Two across on phones: stacked full-width portraits ran to nearly two
             screens of scrolling for three people. The third sits alone on its own
             row, which reads fine and beats shrinking faces to 90px. -->
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
          {team.map((m) => (
            <div>
              {/* alt="" on the portrait: the name and role are rendered as text
                  immediately below it, so describing it again only makes a
                  screen reader say each person's name twice. */}
              <div class="mb-4 overflow-hidden rounded-2xl border border-zinc-200/80 bg-zinc-100">
                <img
                  src={m.img}
                  alt=""
                  width="640"
                  height="800"
                  loading="lazy"
                  class="aspect-4/5 w-full object-cover"
                />
              </div>
              <p class="font-bold tracking-tight text-ink">{m.name}</p>
              <p class="text-sm font-medium text-zinc-500">{m.role}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <section class="section-dark px-6 py-32 text-center">
    <div class="container-tight max-w-2xl">
      <h2 class="mb-6 text-3xl font-extrabold tracking-tight md:text-4xl">
        Questions about any of this?
      </h2>
      <p class="mb-10 text-lg font-medium leading-relaxed text-zinc-400">
        We'd rather explain it than have you guess. Leave us a number and a real person
        gets back to you.
      </p>
      <div class="flex justify-center">
        <a
          href="/contact"
          class="btn-capsule w-fit border-transparent bg-white px-8 py-4 text-base font-bold text-ink shadow-md hover:bg-zinc-100"
        >Talk to us</a>
      </div>
      </div>

    </div>
  </section>
</Layout>
